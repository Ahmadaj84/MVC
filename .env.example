# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_USER / ADMIN_PASSWORD: HTTP Basic credentials protecting the whole app (UI + API).
# Required in production; in development a temporary password is generated and printed if unset.
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me-to-a-long-random-value"

# HOST: interface to bind (default 0.0.0.0). Use 127.0.0.1 to keep the server local-only.
# HOST="127.0.0.1"

# ENABLE_SEED_RESET: set to "true" to allow POST /api/seed/reset in production (disabled by default).
# ENABLE_SEED_RESET="false"
